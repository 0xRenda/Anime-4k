float lumGaussian7(float2 uv, sampler textureSampler, texture2d<float, access::sample> HOOKED, texture2d<float, access::sample> MMKERNEL, vec2 pos, vec2 d) {
	float g = (L_tex(pos - (d + d)).x + L_tex(pos + (d + d)).x) * 0.06136;
	g = g + (L_tex(pos - d).x + L_tex(pos + d).x) * 0.24477;
	g = g + (L_tex(pos).x) * 0.38774;
	return g;
}
vec4 hook(float2 uv, sampler textureSampler, texture2d<float, access::sample> HOOKED, texture2d<float, access::sample> MMKERNEL) {
    return vec4(lumGaussian7(uv, textureSampler, HOOKED, MMKERNEL, HOOKED_pos, vec2(0, HOOKED_pt.y)), minmax3(uv, textureSampler, HOOKED, MMKERNEL, HOOKED_pos, vec2(0, HOOKED_pt.y)), 0);
}
}
kernel void pass_16(texture2d<float, access::sample> HOOKED [[texture(0)]], texture2d<float, access::sample> MMKERNEL [[texture(1)]], texture2d<float, access::write> destination [[texture(2)]], sampler textureSampler [[sampler(0)]], uint2 gid [[thread_position_in_grid]]) {
    if (gid.x >= destination.get_width() || gid.y >= destination.get_height()) return;
    float2 uv = (float2(gid) + 0.5) / float2(destination.get_width(), destination.get_height());
    destination.write(roxy_pass_16::hook(uv, textureSampler, HOOKED, MMKERNEL), gid);
}
